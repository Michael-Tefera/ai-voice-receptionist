{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/ai-voice-receptionist/schemas/tenant-config.schema.json",
  "title": "Tenant Configuration",
  "description": "Provider-neutral tenant configuration schema (draft v0.1)",
  "type": "object",
  "required": ["tenant_id", "display_name", "enabled_modules", "deployment"],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable tenant slug"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "string"
    },
    "extends": {
      "type": "string",
      "description": "Optional base profile path for configuration inheritance"
    },
    "branding": {
      "type": "object",
      "properties": {
        "agent_name": { "type": "string" },
        "voice_style": { "type": "string" },
        "language": { "type": "string" },
        "greeting": { "type": "string" }
      },
      "additionalProperties": true
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone_display": { "type": "string" },
        "email_display": { "type": "string", "format": "email" },
        "website": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "silence_timeout_seconds": { "type": "integer", "minimum": 1 },
        "allow_interruptions": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "persona": {
      "type": "object",
      "additionalProperties": true
    },
    "prompts": {
      "type": "object",
      "properties": {
        "system_prompt": { "type": "string" },
        "system_prompt_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "business_hours": {
      "type": "object",
      "required": ["timezone"],
      "properties": {
        "timezone": { "type": "string" },
        "schedule": { "type": "object" },
        "holidays": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        },
        "after_hours": { "type": "object" }
      },
      "additionalProperties": true
    },
    "routing": {
      "type": "object",
      "properties": {
        "intents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["destination"],
            "properties": {
              "destination": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "escalation": {
      "type": "object",
      "additionalProperties": true
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["inline", "file", "url"] },
              "content": { "type": "string" },
              "content_ref": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "enabled_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["receptionist", "appointments", "support", "leads", "follow-up"]
      },
      "uniqueItems": true
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["calendar", "crm", "notifications", "ticketing", "webhook", "custom"]
          },
          "config_ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string" }
    },
    "default_workflows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["demo", "cloud-multi-tenant", "isolated", "vps"]
        },
        "channels": {
          "type": "array",
          "items": { "enum": ["browser", "telephony"] }
        },
        "features": {
          "type": "object",
          "properties": {
            "recording_enabled": { "type": "boolean" },
            "transcript_storage": { "type": "boolean" },
            "analytics_enabled": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "data_retention": {
          "type": "object",
          "properties": {
            "transcript_days": { "type": "integer", "minimum": 0 },
            "recording_days": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
