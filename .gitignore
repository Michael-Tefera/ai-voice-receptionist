# Dependencies (not installed in this architecture phase)
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment and secrets — NEVER commit real values
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
credentials.json
secrets/

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test and coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.swp

# Local tenant overrides (may contain customer-specific config)
tenants/local/
tenants/*-private/

# Recordings and transcripts (customer data)
recordings/
transcripts/
exports/
